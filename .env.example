# ─────────────────────────────────────────────
# Focus 환경변수 예시
# 이 파일을 .env.local 로 복사해서 사용하세요. (.env.local 은 git에 올라가지 않습니다)
#   cp .env.example .env.local
# ─────────────────────────────────────────────

# 시세 데이터 모드: mock(기본, 샘플 시세) | kis(한국투자증권 Open API)
DATA_PROVIDER=mock

# ── DATA_PROVIDER=kis 일 때만 필요 ──
# KIS Developers(https://apiportal.koreainvestment.com)에서 발급한 앱 키와 시크릿.
# 서버(Route Handler)에서만 읽습니다. NEXT_PUBLIC_ 접두사를 붙이지 마세요.
KIS_APP_KEY=
KIS_APP_SECRET=

# real(실전투자, 기본) | vts(모의투자). 앱 키를 발급받은 환경과 맞춰야 합니다.
KIS_ENV=real

# (선택) 도메인을 직접 지정할 때만 사용
# KIS_BASE_URL=https://openapi.koreainvestment.com:9443
